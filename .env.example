# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Obligatoria ──────────────────────────────────────────────────────────────
# Lo único que necesitas para ejecutar Palmaditas en local.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Solo para la versión de pago ─────────────────────────────────────────────
# Si dejas estas variables vacías, el proyecto arranca en modo libre:
# sin saldo, sin base de datos y sin límite de mensajes.

# Supabase — guarda el saldo por sesión anónima (una sola tabla).
# La service role key salta RLS: solo servidor, NUNCA con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar la cookie de sesión. Genera uno con:
#   openssl rand -base64 32
COOKIE_SECRET=

# Pasarela de pago — proveedor sin decidir (ver docs/business.md).
# Rellenar cuando se elija.
# PAGO_API_KEY=
# PAGO_WEBHOOK_SECRET=

# ─── Opcionales ───────────────────────────────────────────────────────────────
# Resend — enlace de recuperación de saldo por email. No es MVP.
# RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
